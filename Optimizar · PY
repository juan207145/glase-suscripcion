# Reduce el peso de las imágenes para que la página cargue rápido.
# Uso en Codespaces:  pip install pillow  &&  python3 optimizar.py
from PIL import Image
import os

ajustes = {
    "Barcelona_Champions.jpg": 1600,  # ancho máximo en px
    "Barcelona_Logo.jpg": 300,
}

for nombre, ancho in ajustes.items():
    if not os.path.exists(nombre):
        print(f"No encontré {nombre}")
        continue
    antes = os.path.getsize(nombre) / 1024
    img = Image.open(nombre).convert("RGB")
    if img.width > ancho:
        alto = round(img.height * ancho / img.width)
        img = img.resize((ancho, alto), Image.LANCZOS)
    img.save(nombre, "JPEG", quality=72, optimize=True, progressive=True)
    despues = os.path.getsize(nombre) / 1024
    print(f"{nombre}: {antes:.0f} KB -> {despues:.0f} KB")